# Public-source allowlist. Local worlds/assets/releases are never staged by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/LICENSE-STATUS.md
!/THIRD_PARTY_NOTICES.md
!/build_zip.py
!/worldbridge/
!/tests/
!/docs/
!/tools/

/worldbridge/*
!/worldbridge/*.py
/tests/*
!/tests/*.py
/docs/*
!/docs/*.md
/tools/*
!/tools/*.py
!/tools/*.ps1

# Defence in depth, including files nested in allowlisted directories.
**/__pycache__/
*.py[cod]
*.log
*.tmp
*.part
*.zip
*.gz
*.json
*.blend*
*.fbx
*.glb
*.gltf
*.png
*.jpg
*.jpeg
*.exr
*.hdr
*.bin
.env
.env.*
*.pem
*.key
*.p12
*.pfx
**/.aws/
**/.ssh/
**/credentials*
**/tokens*
